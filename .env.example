# Copy to .env.local in the repository root. Never commit real credentials.
# Ask the owner for an authorized connection URL; source code does not grant DB access.
# Read-only access is sufficient for website search/details and JSON exports.
RERA_DATABASE_URL=
# The daily GitHub workflow uses a separate repository Actions secret named
# RERA_UPDATER_DATABASE_URL. Set it privately; never paste its value into YAML.

# Optional local SQLite copies, instead of a hosted database:
# RERA_CATALOG_PATH=data/rera_search.sqlite
# RERA_SNAPSHOT_PATH=data/project_snapshots.sqlite

# Required only for Vercel/stateless live CAPTCHA sessions; generate your own key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RERA_SESSION_KEY=
