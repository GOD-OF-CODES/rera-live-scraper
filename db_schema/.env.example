# Copy to db_schema/.env. This is separate from the website's .env.local.
# Use your own empty development database for schema setup and backfill tests.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Default agents use deterministic database-backed processing without an LLM.
AGENT_FORCE_DIRECT=1
# For optional LLM tool use, set AGENT_FORCE_DIRECT=0 and choose a backend:
AGENT_LLM_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# Or set AGENT_LLM_BACKEND=anthropic and provide your own API key:
# ANTHROPIC_API_KEY=
